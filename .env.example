# App
APP_URL=http://localhost:3000
AUTH_SECRET=
# Passkey relying party (your production domain, without protocol)
WEBAUTHN_RP_ID=localhost
# Email for the magic-link fallback
OWNER_EMAIL=
EMAIL_SERVER=

# Postgres (Railway provides this)
DATABASE_URL=postgres://user:password@localhost:5432/formkoll

# S3-compatible bucket (Railway bucket or similar)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=formkoll
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Claude API (receipt parsing, Ask AI exercise drafts)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# YouTube Data API v3 (exercise demo videos)
YOUTUBE_API_KEY=

# Research agent API (bearer token for /api/agent/*)
AGENT_API_TOKEN=

# Web Push (generate a VAPID key pair)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
