  "climbing": {
    "rules": [
      "At least 48 hours between climbing sessions",
      "No hangboard training while in a calorie deficit",
      "Finger pain flag: 3+ days off climbing, no crimps for a week after"
    ],
    "warm_up": "15–20 min: easy traverse or 6–8 problems well below max, working up the grades; arm circles and band pull-aparts; open-hand grips before small crimps",
    "climb_hard": {
      "duration_min": 100,
      "main": "45–60 min on 3–5 problems at or near the hardest grade; 3–5 attempts each; 3–4 min rest between attempts",
      "finish": "2 × 10 push-ups, 2 × 8 hanging knee raises, forearm and chest stretch"
    },
    "climb_volume": {
      "duration_min": 90,
      "alternate_weeks": [
        "technique: repeat problems 2–3 grades below max with one focus (silent feet, flagging, hips to the wall)",
        "volume: 4×4s, 4 problems back to back, 4 rounds, 3–4 min rest"
      ],
      "note": "Stop while still sharp; frisbee is the next day"
    },
    "grade_scale": "font"
  },
